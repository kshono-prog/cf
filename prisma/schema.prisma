model ProjectSettlement {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              BigInt                  @unique
  status                 ProjectSettlementStatus @default(NOT_READY)
  bridgedTotalAtomic     Decimal                 @default(0) @db.Decimal(78, 0)
  distributedTotalAtomic Decimal                 @default(0) @db.Decimal(78, 0)
  readyAt                DateTime?               @db.Timestamptz(6)
  distributedAt          DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @db.Timestamptz(6)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([createdAt])
}

model ProjectBridgeStep {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           BigInt
  sourceChain         BridgeSourceChain
  destinationChain    BridgeDestinationChain @default(AVALANCHE)
  token               SettlementToken
  status              BridgeStepStatus       @default(PENDING)
  bridgedAmountAtomic Decimal                @default(0) @db.Decimal(78, 0)
  txHash              String?
  completedAt         DateTime?              @db.Timestamptz(6)
  recordedByWallet    String?
  memo                String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @db.Timestamptz(6)
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, sourceChain, destinationChain, token], map: "ProjectBridgeStep_project_source_dest_token_key")
  @@index([projectId, status], map: "ProjectBridgeStep_project_status_idx")
}

model DistributionEntry {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                BigInt
  recipientAddressChecksum String
  token                    SettlementToken
  amountAtomic             Decimal                     @db.Decimal(78, 0)
  memo                     String?
  status                   DistributionEntryStatus     @default(DRAFT)
  sentAt                   DateTime?                   @db.Timestamptz(6)
  txHash                   String?
  orderIndex               Int                         @default(0)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                    @default(now()) @db.Timestamptz(6)
  project                  Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  executionItems           DistributionExecutionItem[]

  @@index([projectId, orderIndex], map: "DistributionEntry_project_order_idx")
  @@index([projectId, status], map: "DistributionEntry_project_status_idx")
  @@index([txHash], map: "DistributionEntry_txHash_idx")
}

model DistributionExecution {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         BigInt
  initiatedByWallet String?
  startedAt         DateTime                    @default(now()) @db.Timestamptz(6)
  finishedAt        DateTime?                   @db.Timestamptz(6)
  result            DistributionExecutionResult @default(PARTIAL_SUCCESS)
  note              String?
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  project           Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items             DistributionExecutionItem[]

  @@index([projectId, startedAt], map: "DistributionExecution_project_started_idx")
}

model DistributionExecutionItem {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId         String                  @db.Uuid
  distributionEntryId String                  @db.Uuid
  status              DistributionEntryStatus
  txHash              String?
  errorReason         String?
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  execution           DistributionExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  distributionEntry   DistributionEntry       @relation(fields: [distributionEntryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([executionId], map: "DistributionExecutionItem_execution_idx")
  @@index([distributionEntryId], map: "DistributionExecutionItem_entry_idx")
}

/// ✅ NEW: bridge execution log (Route B: LOG_ONLY)
model BridgeRun {
  id                            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                     BigInt
  mode                          String
  currency                      String
  eventFundingChainId           Int
  liquidityChainId              Int
  sourceAddress                 String
  vaultAddress                  String
  recipientAddress              String
  tokenAddress                  String
  dbConfirmedTotalAmountDecimal String?
  vaultBalanceRaw               String?
  vaultBalanceFormatted         String?
  recipientBalanceRaw           String?
  recipientBalanceFormatted     String?
  deltaHintJson                 Json    @default("{}")
  force                         Boolean @default(false)
  dryRun                        Boolean @default(false)
  note                          String?

  /// ✅ NEW: user executed bridge tx (source chain)
  bridgeTxHash             String?
  /// ✅ NEW: source receipt block number (string to avoid bigint serialization issues)
  sourceReceiptBlockNumber String?

  /// ✅ NEW: destination verification succeeded
  confirmedAt   DateTime? @db.Timestamptz(6)
  /// ✅ NEW: optional memo for last verify result
  confirmReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
  @@index([createdAt])
  @@index([mode])
  @@index([bridgeTxHash])
  @@index([confirmedAt])
}

