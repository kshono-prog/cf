  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
  @@index([createdAt])
  @@index([mode])
