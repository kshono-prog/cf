generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CreatorProfile {
  id                  BigInt                  @id @default(autoincrement())
  username            String                  @unique
  displayName         String
  profileText         String?
  avatarUrl           String?
  qrcodeUrl           String?
  externalUrl         String?
  themeColor          String?
  creatorType         String?
  ecosystemRole       String?
  walletAddress       String?                 @unique
  email               String?                 @unique
  status              String                  @default("PUBLISHED")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  activeProjectIdJpyc BigInt?
  activeProjectIdUsdc BigInt?
  socialLinks         CreatorSocialLink[]
  youtubeVideos       CreatorYoutubeVideo[]
  events              Event[]
  projects            Project[]
  tips                Tip[]
  socialConnections   SocialConnection[]
  metricSnapshots     ContentMetricSnapshot[]
  posts               Post[]
  replies             Reply[]
  postLikes           PostLike[]
  replyLikes          ReplyLike[]
  aiAgents            AiAgent[]
  aiManagerAccount    AiManagerAccount?
  aiManagerBudgetTransactions AiManagerBudgetTransaction[]
  aiManagerFundingEvidences AiManagerFundingEvidence[]
  aiManagerUsageRecords AiManagerUsageRecord[]
  aiPromotionJobs     AiPromotionJob[]
  agentTasks          AgentTask[]
  agentTaskAuditLogs  AgentTaskAuditLog[]
  managerAssignments  ManagerAssignment[]
  meetings            Meeting[]
  managerNotes        ManagerNote[]
  externalContacts    ExternalContact[]
  actionLogs          ActionLog[]
  expenses            Expense[]
  revenueRecords      RevenueRecord[]
  stageEvidences      StageEvidence[]
  followingRelations  CreatorFollow[]         @relation("CreatorFollowing")
  followerRelations   CreatorFollow[]         @relation("CreatorFollowers")
  projectMembers      ProjectMember[]
}

model CreatorFollow {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerProfileId  BigInt
  followingProfileId BigInt
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  followerProfile    CreatorProfile @relation("CreatorFollowing", fields: [followerProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  followingProfile   CreatorProfile @relation("CreatorFollowers", fields: [followingProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([followerProfileId, followingProfileId], map: "CreatorFollow_follower_following_key")
  @@index([followerProfileId, createdAt], map: "CreatorFollow_follower_created_idx")
  @@index([followingProfileId, createdAt], map: "CreatorFollow_following_created_idx")
}

model CreatorSocialLink {
  id        BigInt         @id @default(autoincrement())
  profileId BigInt
  type      String
  label     String?
  url       String
  createdAt DateTime       @default(now())
  profile   CreatorProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model CreatorYoutubeVideo {
  id          BigInt         @id @default(autoincrement())
  profileId   BigInt
  url         String
  title       String?
  description String?
  createdAt   DateTime       @default(now())
  profile     CreatorProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model Event {
  id               BigInt         @id @default(autoincrement())
  creatorProfileId BigInt
  title            String
  description      String?
  date             DateTime?
  goalAmount       Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  startAt          DateTime       @default(now()) @db.Timestamptz(6)
  endAt            DateTime?      @db.Timestamptz(6)
  placeName        String?
  placeUrl         String?
  ticketUrl        String?
  eventCategories  String[]       @default([])
  goalAmountJpyc   Int?
  isPublished      Boolean        @default(true)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])

  @@index([creatorProfileId])
}

model Tip {
  id               String         @id @default(cuid())
  creatorProfileId BigInt
  amountJpyc       Int
  txHash           String?
  chainId          Int?
  message          String?
  createdAt        DateTime       @default(now())
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])

  @@index([creatorProfileId])
}

model FaucetConfig {
  id              String   @id
  chainId         Int      @unique
  enabled         Boolean  @default(true)
  minJpyc         Int      @default(100)
  requirePolZero  Boolean  @default(true)
  claimAmountPol  String   @default("0.02")
  nonceTtlMinutes Int      @default(10)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @db.Timestamp(6)
}

model FaucetWallet {
  id        String   @id
  chainId   Int
  address   String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@index([chainId, active], map: "FaucetWallet_chain_active_idx")
}

model GasClaim {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  chainId   Int
  address   String
  amountPol String
  txHash    String?  @unique
  status    String   @default("PENDING")
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([chainId, address], map: "GasClaim_chainId_address_key")
}

model GasSupportNonce {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  chainId   Int
  address   String
  nonce     String
  expiresAt DateTime @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([chainId, address], map: "GasSupportNonce_chainId_address_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Allocation {
  id               BigInt   @id @default(autoincrement())
  purposeId        BigInt
  recipientType    String   @default("ADDRESS")
  recipientAddress String
  amountType       String   @default("FIXED")
  amountJpyc       Int?
  ratioBps         Int?
  chainId          Int?
  l1Key            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @db.Timestamptz(6)
  Purpose          Purpose  @relation(fields: [purposeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chainId])
  @@index([purposeId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Contribution {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     BigInt
  purposeId     BigInt?
  chainId       Int
  currency      String
  txHash        String    @unique(map: "Contribution_txHash_unique")
  fromAddress   String
  toAddress     String
  amountRaw     Decimal   @db.Decimal(78, 0)
  decimals      Int
  amountDecimal Decimal?  @db.Decimal(38, 18)
  status        String    @default("PENDING")
  message       String?   @db.Text
  confirmedAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  postTips      PostTip[]
  purpose       Purpose?  @relation(fields: [purposeId], references: [id], onUpdate: NoAction)

  @@index([chainId])
  @@index([createdAt])
  @@index([fromAddress], map: "Contribution_from_idx")
  @@index([projectId])
  @@index([purposeId])
  @@index([status])
  @@index([toAddress], map: "Contribution_to_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Goal {
  id               BigInt      @id @default(autoincrement())
  projectId        BigInt      @unique(map: "Goal_projectId_unique")
  targetAmount     Int
  targetAmountJpyc Int
  deadline         DateTime?   @db.Timestamptz(6)
  achievedAt       DateTime?   @db.Timestamptz(6)
  settlementPolicy Json        @default("{}")
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @db.Timestamptz(6)
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  settlement       Settlement?

  @@index([projectId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Project {
  id                        BigInt                  @id @default(autoincrement())
  ownerAddress              String?
  creatorProfileId          BigInt?
  title                     String
  description               String?
  status                    String                  @default("DRAFT")
  purposeMode               String                  @default("OPTIONAL")
  currency                  String                  @default("JPYC")
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @default(now()) @db.Timestamptz(6)
  liquidityChainId          Int?
  eventFundingChainId       Int?
  eventFundingSourceAddress String?
  eventVaultAddress         String?
  liquidityRecipientAddress String?
  bridgedAt                 DateTime?
  eventBlockchainId         String?
  icttTokenAddress          String?
  icttTokenHome             String?
  icttTokenRemote           String?
  lastBridgeError           String?
  lastBridgeTxHashIcm       String?
  lastBridgeTxHashIctt      String?
  liquidityBlockchainId     String?
  teleporterMessenger       String?
  distributionPlan          Json                    @default("{}")
  bridgeRuns                BridgeRun[]
  budgetItems               BudgetItem[]
  contributions             Contribution[]
  posts                     Post[]
  distributionRuns          DistributionRun[]
  settlementState           ProjectSettlement?
  bridgeSteps               ProjectBridgeStep[]
  distributionEntries       DistributionEntry[]
  distributionExecutions    DistributionExecution[]
  cctpBridgeJobs            CctpBridgeJob[]
  goal                      Goal?
  creatorProfile            CreatorProfile?         @relation(fields: [creatorProfileId], references: [id], onUpdate: NoAction)
  purposes                  Purpose[]
  metricSnapshots           ContentMetricSnapshot[]
  agentTasks                AgentTask[]
  agentTaskAuditLogs        AgentTaskAuditLog[]
  managerNotes              ManagerNote[]
  meetings                  Meeting[]
  externalContacts          ExternalContact[]
  actionLogs                ActionLog[]
  expenses                  Expense[]
  revenueRecords            RevenueRecord[]
  projectMembers            ProjectMember[]
  aiManagerUsageRecords     AiManagerUsageRecord[]

  @@index([creatorProfileId])
  @@index([creatorProfileId, currency])
  @@index([status])
  @@index([eventBlockchainId])
  @@index([liquidityBlockchainId])
}

model CctpBridgeJob {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            BigInt
  currency             SettlementToken        @default(USDC)
  sourceChain          BridgeSourceChain
  destinationChain     BridgeDestinationChain @default(AVALANCHE)
  status               CctpBridgeJobStatus    @default(PENDING)
  idempotencyKey       String                 @unique
  goalAchievedAt       DateTime               @db.Timestamptz(6)
  burnAmountAtomic     Decimal?               @db.Decimal(78, 0)
  burnTxHash           String?
  burnMessageHash      String?
  attestation          String?
  attestationFetchedAt DateTime?              @db.Timestamptz(6)
  mintTxHash           String?
  failureReason        String?
  attempts             Int                    @default(0)
  maxAttempts          Int                    @default(8)
  nextRetryAt          DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @db.Timestamptz(6)
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId, createdAt], map: "CctpBridgeJob_project_created_idx")
  @@index([projectId, status], map: "CctpBridgeJob_project_status_idx")
  @@index([status, nextRetryAt], map: "CctpBridgeJob_status_retry_idx")
}

model SocialConnection {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId BigInt
  platform         String
  accountHandle    String
  accountId        String?
  status           String                  @default("ACTIVE")
  accessTokenRef   String?
  refreshTokenRef  String?
  tokenExpiresAt   DateTime?               @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @db.Timestamptz(6)
  creatorProfile   CreatorProfile          @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  snapshots        ContentMetricSnapshot[]

  @@unique([platform, accountHandle], map: "SocialConnection_platform_handle_key")
  @@index([creatorProfileId, platform, status], map: "SocialConnection_creator_platform_status_idx")
}

model ContentMetricSnapshot {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId   BigInt
  projectId          BigInt?
  socialConnectionId String?           @db.Uuid
  platform           String
  contentExternalId  String
  contentUrl         String?
  postedAt           DateTime?         @db.Timestamptz(6)
  capturedAt         DateTime          @default(now()) @db.Timestamptz(6)
  views              Int?
  likes              Int?
  comments           Int?
  shares             Int?
  rawJson            Json              @default("{}")
  creatorProfile     CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  socialConnection   SocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([creatorProfileId, capturedAt], map: "ContentMetricSnapshot_creator_captured_idx")
  @@index([projectId, platform, capturedAt], map: "ContentMetricSnapshot_project_platform_captured_idx")
  @@index([socialConnectionId], map: "ContentMetricSnapshot_connection_idx")
}

model Post {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId BigInt
  projectId        BigInt?
  authorType       String
  body             String
  mediaType        String?
  mediaUrl         String?
  visibility       String           @default("PUBLIC")
  status           String           @default("DRAFT")
  aiGenerated      Boolean          @default(false)
  aiAgentId        String?          @db.Uuid
  likeCount        Int              @default(0)
  replyCount       Int              @default(0)
  tipCount         Int              @default(0)
  tipAmountJpyc    Decimal          @default(0) @db.Decimal(38, 18)
  tipAmountUsdc    Decimal          @default(0) @db.Decimal(38, 18)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @db.Timestamptz(6)
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  aiAgent          AiAgent?         @relation(fields: [aiAgentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies          Reply[]
  likes            PostLike[]
  tips             PostTip[]
  analytics        PostAnalytics?
  promotionJobs    AiPromotionJob[]

  @@index([status, visibility, createdAt], map: "Post_status_visibility_created_idx")
  @@index([creatorProfileId, status, visibility, createdAt], map: "Post_creator_status_visibility_created_idx")
  @@index([projectId, status, visibility, createdAt], map: "Post_project_status_visibility_created_idx")
  @@index([aiAgentId], map: "Post_aiAgent_idx")
}

model Reply {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId           String         @db.Uuid
  creatorProfileId BigInt
  parentReplyId    String?        @db.Uuid
  authorType       String
  body             String
  aiGenerated      Boolean        @default(false)
  aiAgentId        String?        @db.Uuid
  likeCount        Int            @default(0)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @db.Timestamptz(6)
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parentReply      Reply?         @relation("ReplyTree", fields: [parentReplyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childReplies     Reply[]        @relation("ReplyTree")
  aiAgent          AiAgent?       @relation(fields: [aiAgentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  likes            ReplyLike[]

  @@index([postId, createdAt], map: "Reply_post_created_idx")
  @@index([creatorProfileId, createdAt], map: "Reply_creator_created_idx")
  @@index([parentReplyId, createdAt], map: "Reply_parent_created_idx")
  @@index([aiAgentId], map: "Reply_aiAgent_idx")
}

model PostLike {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId           String         @db.Uuid
  creatorProfileId BigInt
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, creatorProfileId], map: "PostLike_post_creator_key")
  @@index([creatorProfileId], map: "PostLike_creator_idx")
}

model ReplyLike {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  replyId          String         @db.Uuid
  creatorProfileId BigInt
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  reply            Reply          @relation(fields: [replyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([replyId, creatorProfileId], map: "ReplyLike_reply_creator_key")
  @@index([creatorProfileId], map: "ReplyLike_creator_idx")
}

model PostTip {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId         String       @db.Uuid
  contributionId String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, contributionId], map: "PostTip_post_contribution_key")
  @@index([contributionId], map: "PostTip_contribution_idx")
}

model PostAnalytics {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId             String   @unique(map: "PostAnalytics_postId_key") @db.Uuid
  impressionCount    Int      @default(0)
  profileClickCount  Int      @default(0)
  likeCountSnapshot  Int      @default(0)
  replyCountSnapshot Int      @default(0)
  tipCountSnapshot   Int      @default(0)
  tipJpycSnapshot    Decimal  @default(0) @db.Decimal(38, 18)
  tipUsdcSnapshot    Decimal  @default(0) @db.Decimal(38, 18)
  engagementScore    Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt          DateTime @default(now()) @db.Timestamptz(6)
  post               Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AiAgent {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId BigInt
  name             String
  role             String
  status           String           @default("ACTIVE")
  configJson       Json             @default("{}")
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @db.Timestamptz(6)
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts            Post[]
  replies          Reply[]
  jobs             AiPromotionJob[]

  @@index([creatorProfileId, role, status], map: "AiAgent_creator_role_status_idx")
}

model AiManagerAccount {
  id                           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId             BigInt                    @unique
  status                       AiManagerAccountStatus    @default(DRAFT)
  displayName                  String
  slug                         String?
  avatarAssetUrl               String?
  intro                        String?                   @db.Text
  archetype                    AiManagerArchetype        @default(GENTLE_SUPPORTER)
  publicVisibility             AiManagerPublicVisibility @default(OWNER_ONLY)
  primaryLanguage              String                    @default("ja")
  tone                         AiManagerTone             @default(FRIENDLY)
  supportStyle                 AiManagerSupportStyle     @default(ENCOURAGING)
  disclosurePolicy             AiManagerDisclosurePolicy @default(ALWAYS_DISCLOSE_AI)
  managerActivityWalletAddress String?
  budgetWalletAddress          String?
  specialties                  String[]                  @default([])
  forbiddenTopics              String[]                  @default([])
  brandGuardrails              String[]                  @default([])
  createdAt                    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                  @updatedAt @db.Timestamptz(6)
  creatorProfile               CreatorProfile            @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  billingPolicy                AiManagerBillingPolicy?
  budgetBalance                AiManagerBudgetBalance?
  budgetTransactions           AiManagerBudgetTransaction[]
  fundingEvidences             AiManagerFundingEvidence[]
  paymentAttemptEvents         AiManagerPaymentAttemptEvent[]
  usageRecords                 AiManagerUsageRecord[]

  @@index([status, publicVisibility], map: "AiManagerAccount_status_visibility_idx")
}

model AiManagerBillingPolicy {
  aiManagerAccountId          String               @id @db.Uuid
  status                      AiManagerBillingPolicyStatus @default(ACTIVE)
  billingMode                 AiManagerBillingMode @default(MANUAL_TOPUP)
  preferredRail               AiManagerPaymentRail @default(X402_PREFERRED)
  currency                    String               @default("JPYC")
  freeTierEnabled             Boolean              @default(true)
  freeTierScope               AiManagerFreeTierScope @default(BRIEFING_AND_LIGHT_DRAFTS)
  autoPayEnabled              Boolean              @default(false)
  monthlyJpycCap              Int                  @default(3000)
  dailyJpycCap                Int                  @default(300)
  perActionJpycCap            Int                  @default(100)
  allowedBillableCapabilities String[]             @default(["POST_DRAFTING", "FAN_REPLY_ASSIST", "PROGRESS_SUMMARY", "WEB_RESEARCH"])
  pausedAt                    DateTime?            @db.Timestamptz(6)
  pauseReason                 String?              @db.Text
  createdAt                   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(6)
  aiManagerAccount            AiManagerAccount     @relation(fields: [aiManagerAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AiManagerBudgetBalance {
  aiManagerAccountId String           @id @db.Uuid
  currency           String           @default("JPYC")
  availableAmount    Decimal          @default(0) @db.Decimal(18, 2)
  reservedAmount     Decimal          @default(0) @db.Decimal(18, 2)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  aiManagerAccount   AiManagerAccount @relation(fields: [aiManagerAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AiManagerBudgetTransaction {
  id                     String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aiManagerAccountId     String                             @db.Uuid
  creatorProfileId       BigInt
  usageRecordId          String?                            @db.Uuid
  direction              AiManagerBudgetTransactionDirection
  transactionType        AiManagerBudgetTransactionType
  currency               String                             @default("JPYC")
  amount                 Decimal                            @db.Decimal(18, 2)
  resultingAvailableAmount Decimal                          @db.Decimal(18, 2)
  note                   String?                            @db.Text
  actorAddress           String?
  createdAt              DateTime                           @default(now()) @db.Timestamptz(6)
  aiManagerAccount       AiManagerAccount                   @relation(fields: [aiManagerAccountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creatorProfile         CreatorProfile                     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usageRecord            AiManagerUsageRecord?              @relation(fields: [usageRecordId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fundingEvidence        AiManagerFundingEvidence?          @relation("AiManagerBudgetFundingEvidence")

  @@index([aiManagerAccountId, createdAt], map: "AiManagerBudgetTransaction_account_created_idx")
  @@index([creatorProfileId, createdAt], map: "AiManagerBudgetTransaction_creator_created_idx")
  @@index([usageRecordId], map: "AiManagerBudgetTransaction_usage_idx")
}

model AiManagerFundingEvidence {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aiManagerAccountId        String                        @db.Uuid
