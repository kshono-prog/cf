{
  "name": "nagesen-project",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build && node scripts/normalizeRoutesManifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\"}' node --require ts-node/register --require ./tests/register-alias.cjs --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run lint && npm run test && npm run build && npm run typecheck",
    "verify:prisma": "npm run prisma:validate && npm run verify",
    "measure:public-pages": "bash scripts/measurePublicPages.sh",
    "audit:data-integrity": "node scripts/auditDataIntegrity.cjs",
    "manual-check:ai-office:prepare": "node scripts/prepareAiOfficeManualCheck.cjs",
    "manual-check:ai-office:minimum": "node scripts/runAiOfficeMinimumManualCheck.cjs",
    "manual-check:ai-office:smoke": "node scripts/checkAiOfficeManualCheck.cjs",
    "manual-check:ai-office:status": "node scripts/reportAiOfficeManualCheckStatus.cjs",
    "prisma:validate": "prisma validate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/generative-ai": "^0.24.1",
    "@reown/appkit": "^1.8.14",
    "@reown/appkit-adapter-wagmi": "^1.8.14",
    "@reown/walletkit": "^1.4.1",
    "@supabase/storage-js": "^2.86.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.8",
    "@vercel/blob": "^2.0.0",
    "@walletconnect/core": "^2.23.0",
    "@walletconnect/ethereum-provider": "^2.23.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/utils": "^2.23.0",
    "agent-browser": "^0.22.3",
    "ethers": "^6.15.0",
    "next": "^15.5.7",
    "openai": "^6.32.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "viem": "^2.39.0",
    "wagmi": "^2.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3",
    "@metamask/providers": "^22.1.0",
    "@playwright/test": "^1.58.2",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
